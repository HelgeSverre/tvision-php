{
    "name": "helgesverre/turbovision",
    "description": "A modern PHP 8.5 port of Borland's Turbo Vision text-mode UI framework.",
    "type": "library",
    "license": "MIT",
    "keywords": ["tui", "terminal", "turbo-vision", "console", "ncurses"],
    "authors": [
        { "name": "Helge Sverre", "email": "helge.sverre@gmail.com" }
    ],
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": { "HelgeSverre\\TurboVision\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "HelgeSverre\\TurboVision\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
