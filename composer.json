{
  "name": "helgesverre/turbovision",
  "description": "A modern PHP 8.5 port of Borland's Turbo Vision text-mode UI framework.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "tui",
    "terminal",
    "turbo-vision",
    "console",
    "ncurses"
  ],
  "authors": [
    {
      "name": "Helge Sverre",
      "email": "helge.sverre@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "pestphp/pest": "^5.0",
    "phpstan/phpstan": "^2.0"
  },
  "suggest": {
    "ext-pcov": "Enables Pest test-impact analysis and fast code coverage.",
    "ext-xdebug": "Alternative coverage driver for Pest test-impact analysis.",
    "ext-pcntl": "Enables immediate SIGWINCH resize and signal-aware terminal restoration.",
    "ext-posix": "Provides the TTY check fallback on PHP versions without stream_isatty()."
  },
  "autoload": {
    "psr-4": {
      "HelgeSverre\\TurboVision\\": "src/",
      "HelgeSverre\\TurboVision\\Examples\\": "examples/php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HelgeSverre\\TurboVision\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "test:tia": "php bin/tv-test-impact",
    "stan": "phpstan analyse",
    "fuzz": "php bin/tv-fuzz",
    "bench": "php benchmarks/core.php",
    "demo": "php examples/php/workbench.php",
    "demo:kitchensink": "php examples/php/kitchensink.php",
    "demo:workbench": "php examples/php/workbench.php",
    "demo:bios": "php examples/php/bios.php",
    "demo:opencode": "php examples/php/opencode.php",
    "demo:calendar": "php examples/php/calendar.php",
    "demo:studio": "php examples/php/studio.php",
    "demo:html": "php examples/php/html-render.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
